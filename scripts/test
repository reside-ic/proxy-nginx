#!/usr/bin/env bash
set -euo pipefail

HERE=$(dirname "$0")
. "$HERE/common"

NAME="proxy-nginx-test-$$"
NETWORK="$NAME"
UPSTREAM="$NAME-upstream"
PROXY="$NAME-proxy"

cleanup() {
    status=$?
    if [ "$status" -ne 0 ]; then
        docker logs "$UPSTREAM" >&2 || true
        docker logs "$PROXY" >&2 || true
    fi
    docker rm --force --volumes "$PROXY" "$UPSTREAM" >/dev/null 2>&1 || true
    docker network rm "$NETWORK" >/dev/null 2>&1 || true
    exit "$status"
}
trap cleanup EXIT

docker network create "$NETWORK" >/dev/null
docker run --detach --name "$UPSTREAM" --network "$NETWORK" \
    --entrypoint /bin/sh "$TAG_SHA" -c \
    'printf "%s\n" "server { listen 80; location / { return 200 \"proxy smoke test\n\"; } }" > /etc/nginx/conf.d/upstream.conf; exec nginx -g "daemon off;"' >/dev/null
docker run --detach --name "$PROXY" --network "$NETWORK" \
    --publish 127.0.0.1::80 --publish 127.0.0.1::443 \
    "$TAG_SHA" "$UPSTREAM" localhost 80 443 >/dev/null
docker cp "$PACKAGE_ROOT/ssl/certificate.pem" "$PROXY:/run/proxy/certificate.pem"
docker cp "$PACKAGE_ROOT/ssl/key.pem" "$PROXY:/run/proxy/key.pem"

HTTP_PORT=$(docker port "$PROXY" 80/tcp)
HTTPS_PORT=$(docker port "$PROXY" 443/tcp)
BODY=$(curl --insecure --fail --silent --show-error \
    --retry 30 --retry-all-errors --retry-delay 1 --retry-max-time 60 --max-time 2 \
    "https://$HTTPS_PORT/")
if [ "$BODY" != "proxy smoke test" ]; then
    echo "Unexpected HTTPS response: $BODY" >&2
    exit 1
fi
REDIRECT=$(curl --fail --silent --show-error --max-time 5 \
    --output /dev/null --write-out '%{http_code} %{redirect_url}' \
    "http://$HTTP_PORT/smoke?test=1")
if [ "$REDIRECT" != "301 https://localhost:443/smoke?test=1" ]; then
    echo "Unexpected HTTP redirect: $REDIRECT" >&2
    exit 1
fi
echo "Proxy smoke test passed."
