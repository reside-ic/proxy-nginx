#!/usr/bin/env bash
set -eu

if [ "$#" -gt 1 ] || { [ "$#" -eq 1 ] && [ "$1" != "--sha-only" ]; }; then
    echo "Usage: $0 [--sha-only]" >&2
    exit 1
fi

HERE=$(dirname "$0")
. "$HERE/common"

docker push "$TAG_SHA"

if [ "${1:-}" = "--sha-only" ]; then
    exit 0
fi

docker tag "$TAG_SHA" "$TAG_BRANCH"
docker push "$TAG_BRANCH"

if [ "$GIT_BRANCH" = "master" ]; then
   docker tag "$TAG_SHA" "$TAG_LATEST"
   docker push "$TAG_LATEST"
fi
