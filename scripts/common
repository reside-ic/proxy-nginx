#!/usr/bin/env bash
set -e

PACKAGE_ROOT=$(realpath "$HERE/..")
PACKAGE_NAME=proxy-nginx
PACKAGE_ORG=ghcr.io/reside-ic

GIT_SHA=${GIT_SHA:-$(git -C "$PACKAGE_ROOT" rev-parse HEAD)}
GIT_SHA=${GIT_SHA:0:7}
GIT_BRANCH=${GIT_BRANCH:-$(git -C "$PACKAGE_ROOT" symbolic-ref --short HEAD)}
BRANCH_TAG=$(printf '%s' "$GIT_BRANCH" | LC_ALL=C sed 's/[^a-zA-Z0-9_.-]/-/g; s/^[.-]/_/' | cut -c 1-128)
# Reserve latest and commit tags for their intended images.
if [[ "$BRANCH_TAG" == latest || "$BRANCH_TAG" =~ ^[a-fA-F0-9]{7}$ ]]; then
    BRANCH_TAG="branch-$BRANCH_TAG"
fi

TAG_SHA="${PACKAGE_ORG}/${PACKAGE_NAME}:${GIT_SHA}"
TAG_BRANCH="${PACKAGE_ORG}/${PACKAGE_NAME}:${BRANCH_TAG}"
TAG_LATEST="${PACKAGE_ORG}/${PACKAGE_NAME}:latest"
